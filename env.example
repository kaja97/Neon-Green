# AgriFarm AI — Environment template
# Copy to project root:  copy env.example .env

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://agrifarm:dev_password@localhost:5432/agrifarm_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT (generate a long random string for production)
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30

# Service rollout — comma-separated (no AI in v1.0)
DEFAULT_ACCOUNT_SERVICES=activity_plan,weather,soil,disease_watch,market_price

# Weather API (optional — mock data used if missing)
OPENWEATHER_API_KEY=

# Future v2.0 AI (not required now)
# GOOGLE_AI_STUDIO_API_KEY=

# Frontend (create frontend/.env.local with same API URL)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
