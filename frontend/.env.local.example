# =============================================================
#  Frontend (Next.js) — Environment Variables
#  Copy this to .env.local in the /frontend folder
#  ⚠️  Never commit .env.local to Git!
#  In Vercel: add these under Project → Settings → Environment Variables
# =============================================================

# Main backend REST API URL (from Render after deploying backend)
NEXT_PUBLIC_API_URL=https://YOUR-BACKEND-NAME.onrender.com/api/v1



# VAPID public key for push notifications (same as backend VAPID_PUBLIC_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
